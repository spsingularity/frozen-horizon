    given-names: Stilian
    email: stilianpandev@gmail.com
    affiliation: Independent researcher
license: MIT
version: v1.0.0
doi: 10.5281/zenodo.21829379
repository-code: https://github.com/spsingularity/frozen-horizon
keywords:
  - cosmology
  - inflation
  - f(R) gravity
  - cosmic microwave background
  - primordial power spectrum
